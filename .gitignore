# =========================================================================
#  Unified .gitignore for Stockie Platform (Frontend + Backend + AI Engine)
# =========================================================================

# Node.js
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Production build outputs
dist/
backend/dist/
frontend/dist/

# Python Virtual Environments
venv/
.venv/
env/
.env/
ENV/
pyvenv.cfg
.python-version

# Python bytecode / cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Environment configurations (Secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
